{
  "name": "vscode-dfd-preview",
  "displayName": "DFD Preview",
  "description": "A Visual Studio Code extension to preview data flow diagrams from txt files.",
  "version": "0.1.0",
  "publisher": "dfd-priview",
  "repository": {
    "type": "git",
    "url": "https://github.com/zph95/dfd.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onOpenTextDocument:.dfd"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.previewDfd",
        "title": "Preview DFD"
      }
    ],
    "languages": [
      {
        "id": "dfd",
        "extensions": [
          ".dfd"
        ],
        "aliases": [
          "DFD"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dfd",
        "scopeName": "source.dfd",
        "path": "./syntaxes/dfd.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "extension.previewDfd",
          "when": "resourceExtname == .dfd",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "DFD Preview Settings",
      "properties": {
        "dfd.commandPath": {
          "type": "string",
          "default": "data-flow-diagram",
          "description": "Path to the data-flow-diagram command."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npx tsc -p ./",
    "watch": "npx tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "postinstall": "node ./node_modules/vscode/bin/install",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/vscode": "^1.89.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.9.1",
    "typescript": "^5.8.3"
  }
}
